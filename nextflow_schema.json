{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.internal.sanger.ac.uk/malariagen1/misc_utils/read_sim_pipeline/nextflow_schema.json",
  "title": "Read Simulation Pipeline parameters",
  "description": "A pipeline to simulate reads from references containing user-specified mutations.",
  "type": "object",
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "required": ["outdir"],
      "properties": {
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
          "fa_icon": "fas fa-folder-open",
          "default": "./results"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/input_output_options"
    }
  ],
  "properties": {
    "haplotype_manifest": {
      "type": "string",
      "description": "Path to the haplotype manifest file."
    },
    "sample_design_file": {
      "type": "string",
      "description": "Path to the sample design file."
    },
    "run_name": {
      "type": "string",
      "description": "Name of the run."
    },
    "art_read_length": {
      "type": "integer",
      "default": 150,
      "description": "Read length for ART simulation (-l)."
    },
    "art_random_seed": {
      "type": "integer",
      "default": 42,
      "description": "Random seed for reproducibility (-rs)."
    },
    "art_seq_system": {
      "type": "string",
      "default": "MSv3",
      "description": "Sequencing system profile (-ss).",
      "enum": [
        "GA1",
        "GA2",
        "HS10",
        "HS20",
        "HS25",
        "HSXn",
        "HSXt",
        "MinS",
        "MSv1",
        "MSv3",
        "NS50"
      ]
    },
    "art_is_paired_end": {
      "type": "boolean",
      "default": true,
      "description": "Generate paired-end reads (-p)."
    },
    "art_std_dev": {
      "type": "number",
      "default": 20,
      "description": "Standard deviation of fragment lengths (-s)."
    },
    "art_mean_frag_len": {
      "type": "integer",
      "default": 250,
      "description": "Mean fragment length for paired-end reads (-m)."
    },
    "art_additional": {
      "type": "string",
      "default": "",
      "description": "Any extra ART flags not covered by the named parameters, e.g. '-ef' for error-free reads."
    },
    "_trace_timestamp": {
      "type": "string",
      "description": "Timestamp for tracing."
    }
  }
}
