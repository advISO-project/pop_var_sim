process {
    withName: run_art {
        ext.args = { params.art_additional }
    }


    withName: merge_files {
        publishDir = [
            path: { "${params.outdir}/fastqs" },
            mode: "copy"
        ]
    }

    withName: write_output_manifest {
        publishDir = [
            path: { "${params.outdir}" },
            mode: "copy"
        ]
    }

    withName: run_multiqc {
        publishDir = [
            path: { "${params.outdir}" },
            mode: "copy"
        ]
    }
}